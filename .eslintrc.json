{
  "parser": "@babel/eslint-parser",
  "env": {
    "es6": true,
    "browser": true
  },
  "extends": ["react-app", "prettier"],
  "plugins": ["react", "prettier"],
  "settings": {
    "import/resolver": {
      "node": {
        "paths": ["src"],
        "extensions": [".js", ".jsx"]
      }
    }
  },
  "rules": {
    "comma-dangle": "off",
    "no-console": "off",
    "prettier/prettier": ["error"]
  }
}
